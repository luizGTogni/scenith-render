{
  "name": "kairon-render",
  "private": true,
  "description": "Kairon Render — scene-first, React-powered video rendering engine.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "vitest run --coverage",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "changeset:version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "prettier": "^3.9.9",
    "turbo": "^2.11.5",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
