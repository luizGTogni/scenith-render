{
  "name": "@kairon-render/captions",
  "version": "0.0.0",
  "description": "Word-by-word animated captions.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@kairon-render/eslint-config": "workspace:*",
    "@kairon-render/tsconfig": "workspace:*",
    "@kairon-render/tsup-config": "workspace:*",
    "@types/react": "^19.3.0",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  }
}
